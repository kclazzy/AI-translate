{
  "name": "ai-translate",
  "private": true,
  "version": "0.3.6",
  "description": "AI translator for manga, manhwa, webtoons and comics — browser extension, local engine and mobile app",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "build:extension": "pnpm --filter @ait/extension build",
    "build:mobile": "pnpm --filter @ait/mobile build",
    "dev:extension": "pnpm --filter @ait/extension dev",
    "dev:mobile": "pnpm --filter @ait/mobile dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "release": "node scripts/package-release.mjs"
  }
}
