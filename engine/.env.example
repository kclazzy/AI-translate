# AI Translate engine configuration. Copy to .env and adjust.

# Where the engine listens. Keep 127.0.0.1 unless you need phones on your Wi-Fi to connect.
AIT_HOST=127.0.0.1
AIT_PORT=8765

# LAN mode lets phones on the same network use this engine (token still required).
# When enabled the engine listens on 0.0.0.0 and accepts private-network Host headers.
AIT_LAN=false

# Data directory for the pairing token, cache database and cached images.
AIT_DATA_DIR=./data

# Extra allowed CORS origins (comma separated). Chrome/Edge extensions are always allowed.
# The mobile app uses capacitor://localhost (iOS) and http://localhost (Android).
AIT_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost

# Fixed pairing token (optional). If empty, a random token is generated on first start.
AIT_TOKEN=

# Upload limits
AIT_MAX_UPLOAD_MB=60
AIT_MAX_PIXELS=150000000

# Optional local models
# Path to LaMa ONNX (e.g. lama_fp32.onnx from Carve/LaMa-ONNX). Empty = OpenCV inpainting.
AIT_LAMA_ONNX=
# ONNX Runtime providers in priority order.
AIT_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# Cache
AIT_CACHE_DAYS=30
